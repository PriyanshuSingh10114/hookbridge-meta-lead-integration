PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hookbridge

# Meta Developer Platform Credentials
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_custom_verify_token_secure_string
META_PAGE_ACCESS_TOKEN=EAAB...your_page_access_token
META_GRAPH_API_VERSION=v21.0

# CORS & Client URL (set to '*' for local dev, or specific origin in production)
CLIENT_URL=*

# Mobile Client Configuration
# Android Emulator: http://10.0.2.2:5000
# iOS Simulator / Web: http://localhost:5000
# Physical Device (LAN): http://192.168.1.X:5000
API_BASE_URL=http://10.0.2.2:5000
SOCKET_SERVER_URL=http://10.0.2.2:5000
